{
  "name": "chain-talk-arbitrum",
  "compatibility_date": "2024-01-01",
  "main": "./worker.mjs",
  "analytics_engine_datasets": [{ "binding": "JOURNEY", "dataset": "talka_journey" }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/journey"]
  },
  "routes": [
    {
      "pattern": "talka.io99.xyz",
      "custom_domain": true
    }
  ]
}
